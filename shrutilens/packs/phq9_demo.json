    {
      "id": "self_harm_keywords",
      "kind": "keyword",
      "keywords": ["kill myself", "suicide", "end my life", "hurt myself"],
      "severity": "crisis",
      "message": "Self-harm keyword detected. Interrupt assessment and route to crisis protocol."
