  "safety_hooks": [
    {
      "id": "item9_positive",
      "kind": "anchor_match",
      "item_id": "phq9_9",
      "anchor_ids": ["several_days", "more_than_half", "nearly_every_day"],
      "severity": "crisis",
      "message": "Self-harm signal detected. Interrupt assessment and route to crisis protocol."
