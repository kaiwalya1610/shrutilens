{
  "id": "phq9_demo",
  "version": "0.1.0",
  "title": "PHQ-9 Demo Pack",
  "mode": "clinical_locked",
  "language": "en",
  "licensing": "Demo implementation for architecture validation. Confirm licensing and required wording before clinical use.",
  "consent": "This is a structured mental health screening demo, not a diagnosis or emergency service. If you may be in immediate danger, contact local emergency services now.",
